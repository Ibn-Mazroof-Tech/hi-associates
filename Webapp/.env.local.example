# Copy this file to .env.local (for local development) and fill in real
# values. On Vercel, add these under Project Settings → Environment
# Variables instead — never commit real keys to git.

# The Google Apps Script Web App URL (ends in /exec) — see
# google-apps-script/Code.gs and the README for setup steps. Kept as a
# server-only secret (no NEXT_PUBLIC_ prefix) and used only inside
# app/api/apply/route.ts — the browser never sees this URL.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxxxxxx/exec

# From your Razorpay Dashboard → Settings → API Keys.
# RAZORPAY_KEY_SECRET must NEVER be exposed to the browser — it's only
# used inside app/api/razorpay/order/route.ts (server-side).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
